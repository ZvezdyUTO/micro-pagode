syntax = "v1"

info (
    title: "微宝塔"
    serviceMod: 1
)

type(
    StateKV {
        Key int64 `json:"key"`
        Val float64 `json:"val"`
    }
    MonitorStateReq {
        Type string `json:"type,omitempty"`
        StartTime int64 `json:"start_time,omitempty"`
        EndTime int64 `json:"end_time,omitempty"`
    }
    MonitorStateResp {
    	Data []*StateKV `json:"data"`
    }
    MonitorInfoResp {
        CPUState []*StateKV `json:"cpu_state"`
        MemoryState []*StateKV `json:"memory_state"`
        DiskState []*StateKV `json:"disk_state"`
        NetSendState []*StateKV `json:"net_send_state"`
        NetRecvState []*StateKV `json:"net_recv_state"`
    }

    MonitorConfigReq {
        IsStart bool `json:"is_start"`
        CpuLimit float64 `json:"cpu_limit"`
        DiskLimit float64 `json:"disk_limit"`
        MenLimit float64 `json:"men_limit"`
        NetSendLimit float64 `json:"net_send_limit"`
        NetRecvLimit float64 `json:"net_recv_limit"`
        NotifyType int `json:"notify_type"`
        Email string `json:"email"`
    }
    MonitorConfigResp {
        Id int64 `json:"id"`
        IsStart bool `json:"is_start"`
        CpuLimit float64 `json:"cpu_limit"`
        DiskLimit float64 `json:"disk_limit"`
        MenLimit float64 `json:"men_limit"`
        NetSendLimit float64 `json:"net_send_limit"`
        NetRecvLimit float64 `json:"net_recv_limit"`
        NotifyType int `json:"notify_type"`
        Email string `json:""email"`
    }
)

type (
    User {
        Id      int       `json:"id;primary_key"`
        Name     string    `json:"name"`
        Phone    string    `json:"phone"`
        Password string    `json:"password"`
        Status   int64     `json:"status"`
        IsSystem int64     `json:"is_system"`
        CreateAt int64     `json:"create_at"`
        UpdateAt int64     `json:"update_at"`
        DeleteAt int64     `json:"delete_at"`
    }

    File {
        Filename string `json:"filename"`
        Path     string `json:"path"`      // 业务相对路径
        Mtime    int64  `json:"mtime"`
        Size     int64  `json:"size"`
        IsDir    bool   `json:"is_dir"`
        SHA256   string `json:"sha256,omitempty"`
    }
)

type (
    IdReq {
	    Id int `json:"id" from:"id"`
	}
)

type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	LoginResp {
		Token string `json:"token"`
		Id    int    `json:"id"`
		Name  string `json:"name"`
		Status int64    `json:"status"`
		IsSystem int64 `json:"is_system"`
	}

	RegisterReq {
        Name string `json:"name"`
        Phone string `json:"phone"`
        Password string `json:"password"`
        Password2 string `json:"password2"`
    }
    RegisterResp {
        Token string `json:"token"`
        Id int `json:"id"`
        Name string `json:"name"`
        Status int `json:"status"`
    }
)

type(
    UserListReq {
        Ids   []int    `json:"ids,omitempty" query:"ids"`
        Name  string   `json:"name,omitempty" query:"name"`
        Page  int      `json:"page,omitempty" query:"page"`
        Count int      `json:"count,omitempty" query:"count"`
    }
    UserListResp {
        Count int64  `json:"count"`
        List []*User `json:"data"
    }

    UpPasswordReq {
        Id     int    `json:"id"`
        OldPwd string `json:"oldPwd"`
        NewPwd string `json:"newPwd"`
    }
)

type(
    FilePathReq {
        Path string `json:"path" form:"path"`
    }
    FileListResp {
        List []*File `json:"list"`
    }
    FileDeleteReq {
   	    Path      string `json:"path" form:"path"`
   	    Recursive bool   `json:"recursive"`
    }

    UploadFileReq {
        Path string `json:"path" form:"path"`
        File multipart_File
        Header *multipart_FileHeader
        ExpectedSHA256 string `form:"sha256,omitempty"`
    }

    UploadFileResp{}

    FileSearchReq {
        Keyword string `json:"keyword" form:"keyword"` // 搜索关键词

        Prefix bool `json:"prefix" form:"prefix"` // 是否前缀匹配

        // 预留扩展
        OnlyFile bool `json:"only_file,omitempty" form:"only_file"`
        OnlyDir  bool `json:"only_dir,omitempty" form:"only_dir"`
        Limit    int  `json:"limit,omitempty" form:"limit"`
    }

    FileSearchResp {
        Total int           `json:"total"`
        List  []FileSummary `json:"list"`
    }

    FileSummary {
        Path  string `json:"path" form:"path"`
        Name  string `json:"name"`
        IsDir bool   `json:"is_dir"`
    }
)