syntax = "v1"

info (
    title: "微宝塔"
    serviceMod: 1
)

@server(
	group: v1/system
	logic: System
	middleware: JwtMid
)
service System {
	@server (
        handler: Monitor
        logic: System.Monitor
        doc: 系统监控
        logicDoc: 系统监控
    )
    post /monitors returns (MonitorInfoResp)

    @server (
        handler: MonitorState
        logic: System.MonitorState
        doc: 系统监控
        logicDoc: 系统监控
    )
    post /monitors/:type(MonitorStateReq) returns (MonitorStateResp)

    @server (
        handler: GetMonitorConfig
        logic: System.GetMonitorConfig
        doc: 监控数据
    )
    get /monitor/config returns(MonitorConfigResp)

    @server (
        handler: UpdateMonitorConfig
        logic: System.UpdateMonitorConfig
        doc: 监控数据
    )
    post /monitor/config(MonitorConfigReq)
}

